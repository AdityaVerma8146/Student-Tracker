# Frontend (Vite) env vars — copy to .env in the project root.
# The SAME Google client ID is also configured on the backend below.
#
# Get one from https://console.cloud.google.com/apis/credentials
# (Create Credentials -> OAuth client ID -> Web application).
# Add these Authorized JavaScript origins:
#   http://localhost:5173   (Vite dev server)
#   https://your-production-domain.com

VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Only needed if the frontend is deployed on a DIFFERENT host than the
# backend (e.g. frontend on a static host, backend on its own server),
# with nothing proxying /api requests between them. Set this to the
# backend's full URL and every API call will go there directly instead of
# relying on a same-origin /api path.
#   VITE_API_URL=https://your-backend.onrender.com
#
# Leave this unset if Spring Boot serves the built frontend itself (the
# setup described in backend/README.md) — that's already same-origin and
# doesn't need it.
# VITE_API_URL=
