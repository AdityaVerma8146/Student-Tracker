# Copy this file to .env and fill in your own Google OAuth Client ID.
# Get one from https://console.cloud.google.com/apis/credentials
# (Create Credentials -> OAuth client ID -> Web application).
#
# Add these Authorized JavaScript origins in that screen:
#   http://localhost:5173   (Vite dev server)
#   https://your-production-domain.com
#
# The SAME client ID is used on both sides:
#   VITE_GOOGLE_CLIENT_ID  -> read by the React frontend (must start with VITE_)
#   GOOGLE_CLIENT_ID       -> read by the Express backend to verify tokens
#
# Shared auth database location for server-side credential storage.
# Leave this as-is for a local SQLite file.
DB_PATH=./data/auth.db

VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
