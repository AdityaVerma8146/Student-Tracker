# Backend (Spring Boot) environment variables.
# Export these in your shell, or use a tool like `direnv` / your IDE's run
# config — Spring Boot does not read .env files itself.

# Same value as the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Required for the AI Assistant (Fix Mistakes / Build Schedule).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Gmail SMTP defaults are used unless SMTP_HOST is overridden.
# Create a Google App Password (requires 2-Step Verification); do not use
# your normal Gmail password. SMTP_USERNAME should be the sending Gmail address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_AUTH=true
SMTP_STARTTLS=true
# Optional: defaults to SMTP_USERNAME.
MAIL_FROM=

# Optional overrides
PORT=4000
DB_PATH=./data/authdb
