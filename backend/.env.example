# Backend (Spring Boot) environment variables.
# Export these in your shell, or use a tool like `direnv` / your IDE's run
# config — Spring Boot does not read .env files itself.

# Same value as the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Required for the AI Assistant (Fix Mistakes / Build Schedule).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Required for email verification outside the local development profile.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=noreply@example.com

# Optional overrides
PORT=4000
DB_PATH=./data/authdb
